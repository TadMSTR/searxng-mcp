{
  "name": "@tadmstr/searxng-mcp",
  "version": "4.0.0",
  "description": "MCP server for SearXNG — private web search for Claude Code",
  "main": "build/src/index.js",
  "bin": {
    "searxng-mcp": "build/src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TadMSTR/searxng-mcp.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && chmod 755 build/src/index.js",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "coverage": "vitest run --coverage",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "dump-domain": "node build/src/cli/dump-domain.js",
    "domain-db-maintenance": "node build/src/cli/domain-db-maintenance.js",
    "restore-domain-db": "node build/src/cli/restore-domain-db.js"
  },
  "keywords": [
    "searxng",
    "mcp",
    "search"
  ],
  "author": "TadMSTR",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "build/src/",
    "README.md",
    "docs/",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "fast-xml-parser": "^5.12.1",
    "iovalkey": "^0.4.0",
    "jsdom": "^31.0.1",
    "robots-parser": "^3.0.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@ghostery/adblocker": "2.20.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": ">=8.4.0 <9",
      "hono": ">=4.13.16 <5",
      "@hono/node-server": ">=2.1.6 <3",
      "fast-uri": ">=4.2.3 <5",
      "ip-address": ">=10.7.4 <11",
      "body-parser": ">=2.4.0 <3",
      "qs": ">=6.16.1 <7",
      "vite": ">=8.3.5 <9"
    }
  }
}
