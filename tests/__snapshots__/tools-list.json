  {
    "name": "crawl_site",
    "description": "Crawl a site and return a manifest of pages with titles and snippets. Full page content is cached — call fetch_url on any page URL for the full text. Strategy: Firecrawl (JS rendering) → sitemap-first → BFS (if enabled). A start URL with a path (e.g. https://example.com/docs) limits the crawl to pages under that path unless include_path is given; include_path '/' crawls the whole site.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Base URL to crawl. Its path scopes the crawl when include_path is omitted"
        },
        "max_pages": {
          "description": "Maximum pages to crawl (default 20, max 100)",
          "default": 20,
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "same_domain_only": {
          "description": "Restrict crawl to the same domain (default true)",
          "default": true,
          "type": "boolean"
        },
        "include_path": {
          "description": "Only include URLs matching this path prefix (e.g. '/docs'); replaces the start URL's default scope, '/' for the whole site",
          "type": "string"
        },
        "exclude_path": {
          "description": "Exclude URLs matching this path prefix (e.g. '/blog')",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "clear_cache",
    "description": "Purge the search and/or fetch result cache. Useful when researching fast-moving topics where cached results from the past hour may be stale.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "description": "Which cache to clear: search results, fetched pages, crawl manifests, or all (default all)",
          "default": "all",
          "type": "string",
          "enum": [
            "search",
            "fetch",
            "crawl",
            "all"
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
